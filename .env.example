# Servidor
PORT=8080

# Proveedor: live (producción) o demo (solo desarrollo explícito).
MARKET_DATA_PROVIDER=deriv-public
# ID pÃºblico de tu aplicaciÃ³n Deriv. No pongas tokens de cuenta en el cliente.
DERIV_APP_ID=
DERIV_WEBSOCKET_URL=wss://ws.derivws.com/websockets/v3
ALLOW_DEMO_PROVIDER=false
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_WEBSOCKET_URL=
# Endpoint REST autorizado para velas OHLC cerradas.
MARKET_DATA_HISTORICAL_URL=

# Fuentes verificadas de noticias/calendario y modelo opcional del servidor.
NEWS_API_KEY=
NEWS_API_URL=
NEWS_SOURCE=
ECONOMIC_CALENDAR_API_KEY=
ECONOMIC_CALENDAR_API_URL=
ECONOMIC_CALENDAR_SOURCE=
ECONOMIC_CALENDAR_SOURCE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=

# Límites de riesgo del análisis informativo.
MAX_SPREAD_EURUSD=0.0003
MAX_SPREAD_GBPUSD=0.0004
MAX_SPREAD_USDJPY=0.04
MAX_SPREAD_XAUUSD=1.5
MAX_DAILY_LOSS=0
MAX_DAILY_DRAWDOWN_PERCENT=0
MAX_SPREAD_BPS_EURUSD=3.5
MAX_SPREAD_BPS_GBPUSD=4.5
MAX_SPREAD_BPS_USDJPY=3.5
MAX_SPREAD_BPS_XAUUSD=18

# Símbolos del proveedor autorizado; no todos usan el mismo formato.
FOREX_EURUSD_SYMBOL=frxEURUSD
FOREX_GBPUSD_SYMBOL=frxGBPUSD
FOREX_USDJPY_SYMBOL=frxUSDJPY
FOREX_XAUUSD_SYMBOL=frxXAUUSD

# Símbolos públicos, solo para el widget visual oficial de TradingView.
TV_EURUSD_SYMBOL=FX:EURUSD
TV_GBPUSD_SYMBOL=FX:GBPUSD
TV_USDJPY_SYMBOL=FX:USDJPY
TV_XAUUSD_SYMBOL=TVC:GOLD
